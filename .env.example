# ============================================================
# CẤU HÌNH CHO INTO_SHORT_CLIPS (AI YOUTUBE SHORTS GENERATOR)
# ============================================================

# 1. Chọn LLM Provider cho chế độ Local Mode (--mode local):
#    - "ollama": Chạy 100% Offline trên máy (Mặc định, Không cần API Key, Miễn phí)
#    - "gemini": Dùng Google Gemini API (Miễn phí từ aistudio.google.com, siêu nhanh)
#    - "openai": Dùng OpenAI API (Cần OPENAI_API_KEY)
LLM_PROVIDER=ollama

# Cấu hình khi dùng Ollama (100% Local Offline):
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Cấu hình khi dùng Google Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình khi dùng OpenAI API:
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# 2. Cấu hình Whisper phiên âm giọng nói (Local STT):
# Kích cỡ model: tiny, base, small, medium, large-v3 (Khuyên dùng 'base' hoặc 'small' trên CPU)
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto

# 3. Thư mục xuất video Shorts đầu ra:
LOCAL_OUTPUT_DIR=output
